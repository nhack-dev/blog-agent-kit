# このファイルを .env という名前でコピーし、右側を書き換えてください。.env は Git に入れません。

# --- WordPress（下書き投稿に使う） ---
# サイトの URL（末尾の / は無くてよい）。https のサイトだけで使えます。
WP_URL=https://example.com
# WordPress にログインするときのユーザー名
WP_USER=your-user-name
# ユーザー → プロフィール →「アプリケーションパスワード」で作った24文字（スペースはあってもなくてもよい）
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Google Search Console（公開後の振り返り・任意） ---
# Search Console に登録した形のまま（URL プレフィックスなら https://example.com/ ・ドメインなら sc-domain:example.com）
GSC_SITE_URL=https://example.com/
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
# python3 scripts/gsc_auth.py --go で出た値を貼る
GSC_REFRESH_TOKEN=
